# Copy to .env or export in your shell. Never commit real values.
# `ga` reads credentials from the environment only.

# Anthropic (Claude) generation
ANTHROPIC_API_KEY=

# Optional: OpenAI generation and/or embeddings
OPENAI_API_KEY=

# Optional: a local sentence-transformers model directory, used without any download at run time
GA_LOCAL_EMBEDDING_MODEL_DIR=
